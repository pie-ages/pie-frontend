{
  "expo": {
    "name": "pie",
    "slug": "pie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pie",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false
    },
    "ios": {
      "bundleIdentifier": "br.pucrs.ages.pie",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "br.pucrs.ages.pie",
      "adaptiveIcon": {
        "backgroundColor": "#FEE2D7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/pie-logo.png",
          "imageWidth": 220
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O app acessa sua câmera para fotografar peças e iniciar a colorimetria.",
          "microphonePermission": false,
          "photosPermission": "O app acessa suas fotos para adicionar uma imagem ao look."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d5950654-7ef4-4055-b11a-728a0fb3a8b7"
      }
    },
    "owner": "vitoriagraffs-team"
  }
}
